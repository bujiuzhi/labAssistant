# Java API
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8000
# Java API 开发环境默认开放到局域网；生产环境应设为 127.0.0.1
API_BIND_ADDRESS=0.0.0.0
SESSION_COOKIE_SECURE=false
DATABASE_MAX_POOL_SIZE=10

# Vue 开发前端：局域网访问使用 0.0.0.0；生产环境应设为 127.0.0.1
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=5173

# 仅用于开发数据初始化，生产环境不得沿用
MATERIALS_LAB_DEVELOPMENT_PASSWORD=00000000

# PostgreSQL 开发测试库：DBX 可通过局域网直连
SPRING_PROFILES_ACTIVE=dev
POSTGRES_DEV_DB=materials_lab_dev
POSTGRES_DEV_USER=dev
POSTGRES_DEV_PASSWORD=dev123456
# 生产数据库（仅在 SPRING_PROFILES_ACTIVE=prod 时使用）
POSTGRES_PROD_DB=materials_lab
POSTGRES_PROD_USER=materials_lab
POSTGRES_PROD_PASSWORD=replace-with-a-strong-password
# 开发环境默认开放到局域网；生产环境应设为 127.0.0.1
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

# RustFS / S3 兼容对象存储开发配置
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:19000
OBJECT_STORAGE_BIND_ADDRESS=0.0.0.0
OBJECT_STORAGE_API_PORT=19000
OBJECT_STORAGE_CONSOLE_PORT=19001
OBJECT_STORAGE_ACCESS_KEY=dev
OBJECT_STORAGE_SECRET_KEY=dev123456
OBJECT_STORAGE_BUCKET_NAME=materials-lab-assistant
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_VERIFY_TLS=false
OBJECT_STORAGE_PRESIGNED_URL_EXPIRY_SECONDS=300

# 远程开发持久化目录
MATERIALS_LAB_DATA_ROOT=/home/bujiu/work/data/docker/materials-lab-assistant
