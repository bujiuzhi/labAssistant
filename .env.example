# Django
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.0.156
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://192.168.0.156:5173

# 仅用于开发数据初始化，生产环境不得沿用
MATERIALS_LAB_DEVELOPMENT_PASSWORD=00000000

# PostgreSQL
DATABASE_ENGINE=postgresql
POSTGRES_DB=materials_lab
POSTGRES_USER=materials_lab
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2

# RustFS / S3 兼容对象存储
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:19000
OBJECT_STORAGE_API_PORT=19000
OBJECT_STORAGE_CONSOLE_PORT=19001
OBJECT_STORAGE_ACCESS_KEY=replace-with-a-random-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-secret
OBJECT_STORAGE_BUCKET_NAME=materials-lab-assistant
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_VERIFY_TLS=false
OBJECT_STORAGE_PRESIGNED_URL_EXPIRY_SECONDS=300

# 远程开发持久化目录
MATERIALS_LAB_DATA_ROOT=/home/bujiu/work/data/docker/materials-lab-assistant
