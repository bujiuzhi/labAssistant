# 仅非敏感配置。复制为仓库根 .env.production，填写实际绝对路径。
# 运维脚本不执行此文件：仅接受 MATERIALS_LAB_ 前缀的 KEY=VALUE，禁止引号、$、反引号和行内注释。
MATERIALS_LAB_COMPOSE_PROJECT=materials-lab-production
# 运行时仅引用该已构建并已验证的标签；建议使用已审查 Git SHA，不使用 latest。
# build/up/upgrade 不会覆盖同标签镜像；将镜像推送到受控仓库或导入目标服务器后再部署。
MATERIALS_LAB_RELEASE=CHANGE_ME
MATERIALS_LAB_DATA_ROOT=/home/CHANGE_ME/work/data/labAssistant
MATERIALS_LAB_SECRETS_DIR=/home/CHANGE_ME/work/server/labAssistant/data/production-secrets
MATERIALS_LAB_DB_NAME=materials_lab
MATERIALS_LAB_DB_USER=materials_lab_app
MATERIALS_LAB_DB_POOL_SIZE=20
MATERIALS_LAB_OBJECT_STORAGE_BUCKET=materials-lab-assistant

# 经明确授权的少量用户公网明文访问。仅 Web 端口映射宿主，数据库、RustFS 与 API 不开放。
MATERIALS_LAB_PUBLIC_HOST=CHANGE_ME
MATERIALS_LAB_PUBLIC_PORT=15105
MATERIALS_LAB_HTTP_BIND_ADDRESS=0.0.0.0
MATERIALS_LAB_HTTP_BIND_PORT=15105

# 真实身份，不创建任何示例项目/实验；重复 bootstrap 会被拒绝。
MATERIALS_LAB_BOOTSTRAP_ORGANIZATION_CODE=CHANGE_ME
MATERIALS_LAB_BOOTSTRAP_ORGANIZATION_NAME=CHANGE_ME
MATERIALS_LAB_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
MATERIALS_LAB_BOOTSTRAP_ADMIN_DISPLAY_NAME=CHANGE_ME
